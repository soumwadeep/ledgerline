# Copy this file to .env.local and fill in the values yourself.
# Do not paste these into a chat window, an issue, or a screenshot.
# .env.local is git ignored. The keys never leave this machine.

# ---- which money layer the engine talks to -------------------------------
# sim        local simulation of the documented sandbox contract (default).
#            Runs the whole product with no credentials and no network.
# airwallex  the real Airwallex sandbox. Needs the two keys below.
LEDGERLINE_GATEWAY=sim

# ---- Airwallex sandbox credentials ---------------------------------------
# Sandbox web app > Account > Developer > API keys
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# Optional. Needed only for the "simulate deposit" button on the live gateway.
# Find it under Wallet > Global accounts, or create one with the diagnose step.
AIRWALLEX_GLOBAL_ACCOUNT_ID=

# Optional. Overrides the sandbox host.
# AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# AIRWALLEX_API_VERSION=2019-07-12

# ---- optional model proposer ---------------------------------------------
# Without this the deterministic allocator runs, and the product is complete.
# The model only ever proposes intents; it cannot move money.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
